{
  "expo": {
    "name": "New Catch",
    "slug": "newcatch",
    "scheme": "newcatch",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.heisallaki.newcatch"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow New Catch to access your photos so you can add profile pictures."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ff4d8d",
          "icon": "./assets/notification-icon.png"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dc1ae0b3-a664-4247-8c7b-ac02fced32b0"
      }
    },
    "owner": "heisallaki",
    "android": {
      "package": "com.heisallaki.newcatch",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#1b0a3d"
      }
    }
  }
}
